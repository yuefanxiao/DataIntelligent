# 网关配置面模板（spec §4.9「env 可覆盖」；ADR-0009 凭证只在宿主机 env 文件）。
#
# 部署步骤：
#   1. cp env.example env && chmod 600 env
#   2. 填数据库凭证（共享只读角色 DSN；provisioning 见 deploy/provisioning/）
#   3. docker compose -f ../docker-compose.yml up -d --build
#
# 本文件部署时不提交 git（.gitignore：deploy/config/env）；开发机/CI 零凭证。

# 三挂载路径（compose 挂载对应；容器内固定）
DGW_DB_PATH=/data/dgw.db
DGW_EXEC_LOG_DIR=/logs
DGW_HTTP_ADDR=:8080

# execute_sql 行数上限（默认 500，范围 500-5000）
DGW_SQL_LIMIT=500

# statement_timeout 毫秒（默认 30000；须与角色级 ALTER ROLE ... SET
# statement_timeout 一致——启动自检硬校验，不一致拒启）
DGW_PG_STATEMENT_TIMEOUT_MS=30000

# 并发闸（每 key / 进程级，默认 2/8；超限结构化拒绝不排队）
DGW_KEY_CONCURRENCY=2
DGW_PROCESS_CONCURRENCY=8

# 执行记录保留（原始 7 天轮转 / 聚合摘要 30 天）
DGW_EXEC_RAW_RETENTION_DAYS=7
DGW_EXEC_SUMMARY_RETENTION_DAYS=30

# 数据库路由表（JSON 数组；DSN 即凭证，只存本文件）。生产形态 = 从库
# replica-host + 共享只读角色 dgw_reader（见 deploy/provisioning/readonly-role.sql）。
# 注意：env_file 一行一个变量，JSON 须为单行。
# 安全：DSN 必须连「从库」+「共享只读角色」——启动自检两条硬校验兜底
# （pg_is_in_recovery() = true + 角色级 statement_timeout 生效，不过拒启）。
DGW_PG_DATABASES=[{"dbname":"bill","service":"bss-bill","dsn":"postgres://dgw_reader:CHANGE_ME@replica-host:5432/bill?sslmode=verify-full"},{"dbname":"wallet","service":"bss-wallet","dsn":"postgres://dgw_reader:CHANGE_ME@replica-host:5432/wallet?sslmode=verify-full"}]

# stdio 调试形态（serve-stdio）的凭据；HTTP 形态不需要
# DGW_API_KEY=

# semantic-sync 的 embedding（缺省跳过向量生成，检索降级为关键词 FTS5）
# DGW_OPENAI_API_KEY=
# DGW_EMBEDDING_MODEL=text-embedding-3-small
